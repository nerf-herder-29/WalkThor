<?xml version="1.0" encoding="utf-8"?>
<!-- WalkThor coming up by itself on the bottom screen (as a game starts, or back mid-game):
     grows in from 90%, fading up as it does, as the drawer does. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="380"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <scale
        android:fromXScale="0.9" android:toXScale="1.0"
        android:fromYScale="0.9" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" />
</set>

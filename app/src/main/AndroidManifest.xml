<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for scraping artwork, and only when you've added a scraper account and start a scrape. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates: installs a new version of WalkThor or an emulator you chose to update (Android asks you first). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A short buzz when a button shortcut is used. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only for the test notification in Diagnostics. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Bring WalkThor forward when you tap its search field while a game has focus. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Mirror: holding a screen-capture session while the mirror screen is open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Coming back promptly after Android closes WalkThor: a standing alarm that starts it again. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- "Triple-press the AYN button: close all apps", where AYN's system helper can't be reached. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Captions: Android requires this to capture the game's own sound (playback capture);
         WalkThor never uses the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The Apps tab lists apps with a home-screen icon so you can open them on either screen. -->
    <!-- The top screen's brightness from Now playing's quick controls (Android asks you first). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <queries>
        <!-- AYN's drawer app: only to list what it offers in the Diagnostics button test. -->
        <package android:name="com.odin.dualscreen.assistant" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Launchers (home apps): so they're never taken for a game, even without a home-screen icon. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Captions: Android only lets WalkThor see the device's speech recognizer if it says so here. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WalkThor">

        <!-- Shows Android's prompts and pickers for the drawer (only an app screen can), then closes. -->
        <activity
            android:name=".PromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity="com.nerfherder.walkthor.prompt"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Another app adding a shortcut to the home screen (when WalkThor is your home app). -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.nerfherder.walkthor.pin"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <!-- The top screen's spotlight while you choose a game on the bottom screen; also
             WalkThor's home screen, if you pick WalkThor as your home app. -->
        <activity
            android:name=".FrontendTopActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.nerfherder.walkthor.top"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.WalkThor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The bottom screen's home, when WalkThor is your home app: your games stay
                 there instead of Android's own launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- "Open with WalkThor" from a file manager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- "Share to WalkThor" -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Mirror: holds the screen-capture session while part of the top screen is mirrored. -->
        <service
            android:name=".MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- Swipe-down-to-open gesture on the bottom screen (optional, off unless switched on). -->
        <service
            android:name=".SwipeGestureService"
            android:exported="true"
            android:label="@string/swipe_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/swipe_gesture_service" />
        </service>
        <!-- Starts WalkThor again just after a crash (see CrashLog). -->
        <receiver android:name=".ComeBack" android:exported="false" />
        <!-- Updates: Android's answer to an install WalkThor started. -->
        <receiver android:name=".data.Updates$InstallResult" android:exported="false" />
        <!-- WalkThor's keyboard (numbers and letters filling the bottom screen), to use in place of AYN's. -->
        <service
            android:name=".keyboard.WalkThorKeyboard"
            android:exported="true"
            android:label="WalkThor keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/walkthor_keyboard" />
        </service>
        <!-- Notices WalkThor being closed by Android and starts it again (see CrashLog). -->
        <service android:name=".Keeper" android:exported="false" android:process=":keeper" />
        <!-- Notifications on the bottom screen (off unless switched on and given notification access). -->
        <service
            android:name=".NotifyListener"
            android:exported="true"
            android:label="WalkThor notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
